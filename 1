from google import genai
import customtkinter as ctk
import keyboard
import mss
import threading
from PIL import Image
import os
import warnings

# Hide the Trio/Runtime warnings
warnings.filterwarnings("ignore", category=RuntimeWarning)

# --- CONFIGURATION ---
API_KEY = "AIzaSyC6fQ74V6z54WSNemzGBJou-5JyK7PJ-dw"
HOTKEY = "ctrl+shift+s"

# FIX: Force API version to 'v1' to prevent 404/deprecated errors
client = genai.Client(
    api_key=API_KEY,
    http_options={'api_version': 'v1'}
)

class OverlayApp(ctk.CTk):
    def __init__(self):
        super().__init__()
        
        # Setup window: Bottom Left, Always on Top
        self.overrideredirect(True)
        self.attributes("-topmost", True)

        screen_h = self.winfo_screenheight()
        # Slightly wider for longer answers: 250x40
        self.geometry(f"150x40+10+{screen_h - 60}") 
        self.configure(fg_color="#1a1a1a")

        self.label = ctk.CTkLabel(self, text="Ready (Ctrl+Shift+S)", text_color="white", 
                                  wraplength=230, font=("Arial", 8, "bold"))
        self.label.pack(expand=True, fill="both", padx=5, pady=2)

        keyboard.add_hotkey(HOTKEY, self.start_analysis)

    def start_analysis(self):
        self.label.configure(text="Processing...", text_color="#ffcc00")
        threading.Thread(target=self.get_online_answer).start()

    def get_online_answer(self):
        try:
            # 1. Capture Screen
            with mss.mss() as sct:
                monitor = sct.monitors[1] # Primary monitor
                sct_img = sct.grab(monitor)
                img = Image.frombytes("RGB", sct_img.size, sct_img.bgra, "raw", "BGRX")
            
            # 2. Call Gemini 2.5 Flash (The current stable workhorse)
            response = client.models.generate_content(
                model="gemini-2.5-flash",
                contents=["Solve the machining question in this image. Final answer only.", img]
            )
            
            # 3. Update the Box
            answer = response.text.strip()
            self.after(0, lambda: self.label.configure(text=answer, text_color="#00ff00"))
            
        except Exception as e:
            print(f"Error: {e}")
            self.after(0, lambda: self.label.configure(text="Error: Check API/Model", text_color="red"))

if __name__ == "__main__":
    app = OverlayApp()
    app.mainloop()
