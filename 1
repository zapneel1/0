# --- CONFIGURATION ---
API_KEY = "AQ.Ab8RN6Kd0yS5fZSwWdGV45qWtFmeCqAIlMlEnNYrHKy7d0kUEw"
HOTKEY = "ctrl+shift+s"

client = genai.Client(
    api_key=API_KEY,
    http_options={'api_version': 'v1'}
)

class OverlayApp(ctk.CTk):
    def __init__(self):
        super().__init__()
        
        # Window setup
        self.overrideredirect(True)
        self.attributes("-topmost", True)

        self.update_idletasks()
        screen_h = self.winfo_screenheight()

        # KEEPING YOUR ORIGINAL SIZE
        self.geometry(f"150x20+12+{screen_h - 20}")  
        self.configure(fg_color="#000000")

        # ✅ Scrollable text box (hidden scrollbar)
        self.textbox = ctk.CTkTextbox(
            self,
            wrap="word",
            font=("Arial", 8, "bold"),
            text_color="#FFFFFF",
            fg_color="#000000",
            border_width=0,
            corner_radius=0,
            scrollbar_button_color="#000000",
            scrollbar_button_hover_color="#000000"
        )
        self.textbox.pack(expand=True, fill="both", padx=2, pady=0)

        self.textbox.configure(state="disabled")

        keyboard.add_hotkey(HOTKEY, self.start_analysis)

    def update_text(self, content):
        self.textbox.configure(state="normal")
        self.textbox.delete("1.0", "end")
        self.textbox.insert("1.0", content)
        self.textbox.see("end")  # auto-scroll
        self.textbox.configure(state="disabled")

    def start_analysis(self):
        self.update_text("http://10.3.100.41?url=pProcessing")
        threading.Thread(target=self.get_online_answer).start()

    def get_online_answer(self):
        try:
            with mss.mss() as sct:
                monitor = sct.monitors[1]
                sct_img = sct.grab(monitor)
                img = Image.frombytes("RGB", sct_img.size, sct_img.bgra, "raw", "BGRX")
            
            response = client.models.generate_content(
                model="gemini-2.5-flash",
                contents=["Solve the question in this image. reply with answer only.", img]
            )
            
            answer = response.text.strip()
            self.after(0, lambda: self.update_text(answer))
            
        except Exception as e:
            print(f"Error: {e}")
            self.after(0, lambda: self.update_text("http://10.3.100.41?url=pError"))

if __name__ == "__main__":
    app = OverlayApp()
    app.mainloop()


